Options -Indexes -MultiViews
DirectoryIndex index.php

RewriteEngine On

# Always use HTTPS for the public status domain.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Canonical public URLs never expose the underlying PHP filenames.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(admin|login|register|verify|logout|action|live-status|archive|content|subscribe|unsubscribe|community-action|profile-card|forums|forum-topic)\.php(?:[?\s]) [NC]
RewriteRule ^([a-z-]+)\.php$ /$1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+admin-(incidents|maintenance|posts|webhooks|servers|login|verify|logout)\.php(?:[?\s]) [NC]
RewriteRule ^admin-([a-z-]+)\.php$ /admin/$1 [R=301,L,NE]

# Clean application routes. The real PHP files remain private implementation details.
RewriteRule ^admin/?$ admin.php [L,QSA]
RewriteRule ^admin/incidents/?$ admin-incidents.php [L,QSA]
RewriteRule ^admin/maintenance/?$ admin-maintenance.php [L,QSA]
RewriteRule ^admin/posts/?$ admin-posts.php [L,QSA]
RewriteRule ^admin/webhooks/?$ admin-webhooks.php [L,QSA]
RewriteRule ^admin/servers/?$ admin-servers.php [L,QSA]
RewriteRule ^admin/login/?$ admin-login.php [L,QSA]
RewriteRule ^admin/verify/?$ admin-verify.php [L,QSA]
RewriteRule ^admin/logout/?$ admin-logout.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^action/?$ action.php [L,QSA]
RewriteRule ^community-action/?$ community-action.php [L,QSA]
RewriteRule ^profile-card/?$ profile-card.php [L,QSA]
RewriteRule ^live-status/?$ live-status.php [L,QSA]
RewriteRule ^subscribe/?$ subscribe.php [L,QSA]
RewriteRule ^unsubscribe/?$ unsubscribe.php [L,QSA]
RewriteRule ^incidents/?$ archive.php?type=incidents [L,QSA]
RewriteRule ^maintenance/?$ archive.php?type=maintenance [L,QSA]
RewriteRule ^posts/?$ archive.php?type=posts [L,QSA]
RewriteRule ^forums/?$ forums.php [L,QSA]
RewriteRule ^forums/([a-z0-9][a-z0-9-]{0,189})/?$ forum-topic.php?slug=$1 [L,QSA]
RewriteRule ^incidents/([a-z0-9][a-z0-9-]{0,119})/?$ content.php?type=incident&slug=$1 [L,QSA]
RewriteRule ^maintenance/([a-z0-9][a-z0-9-]{0,119})/?$ content.php?type=maintenance&slug=$1 [L,QSA]
RewriteRule ^posts/([a-z0-9][a-z0-9-]{0,119})/?$ content.php?type=post&slug=$1 [L,QSA]

# Never expose configuration or helper files directly.
<FilesMatch "^(config\.php|lib\.php|community-lib\.php|status-content\.php|README.*|database\.sql|.*\.log|.*\.gs|appsscript\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:png|jpg|jpeg|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
